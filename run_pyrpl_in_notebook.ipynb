    "    \"    iir.output_direct = \\\"out2\\\"\\n\",\n",
    "    \"    iir.inputfilter = 1e3\\n\",\n",
    "    \"    iir.bypass = False\\n\",\n",
    "    \"    iir.on = True\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"status:\\\", iir.overflow, \\\"bits:\\\", bin(iir.overflow_bitfield))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Coefficients: {iir.coefficients[0]}\\\")\"\n",
