    "    \"\\n\",\n",
    "    \"# Batch the configuration into one setup\\n\",\n",
    "    \"with iir.do_setup:\\n\",\n",
    "    \"    iir.loops = 400\\n\",\n",
    "    \"    iir.zeros = []\\n\",\n",
    "    \"    iir.poles = [-707.1067811865476 + 707.1067811865476j]  # +Im only; conjugate is auto-added\\n\",\n",
