env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
cover/*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
xunit.xml
unit_tests.xml

# Translations
*.mo
*.pot

# PyBuilder
target/

