# PyRPL User Data
# ==============================================================================

# User curves
curves/

# Config backups
pyrpl/config/*.bak
*.bak

# User config
pyrpl/config/user_config/*.yml
pyrpl/config/user_config/*.bak
pyrpl/config/user_config

# ==============================================================================
# PyRPL Test files
# ==============================================================================

test_import.py
run.py
rpiq_gui.py
rpiq.ui

# ==============================================================================
# PyRPL Distribution
# ==============================================================================

README.rst
scripts/dist/
scripts/build/
scripts/__init__.py
scripts/run_pyrpl.spec
scripts/pyrpl.spec
cover/index.html

# Notebooks
run_pyrpl_in_notebook.ipynb
!docs/source/*
!docs/source/developer_guide/dist

# ==============================================================================
# Vivado / FPGA Build System
# ==============================================================================

# Vivado journal and log files (anywhere in repo)
*.jou

# Vivado hidden directories
pyrpl/fpga/.*

# Vivado project directories
pyrpl/fpga/project/
pyrpl/fpga/sdk

# Vivado generated files in main fpga directory
pyrpl/fpga/*.html
pyrpl/fpga/*.xml
pyrpl/fpga/*.dmp
pyrpl/fpga/red_pitaya.prm

# FPGA build output (bitstreams, checkpoints and Vivado reports are all
# regenerated by every synthesis run - none of it belongs in the repository)
pyrpl/fpga/out/

# Manually kept bitstream snapshots (red_pitaya.bin.bak_<date>_<tag>)
pyrpl/fpga/*.bin.bak_*

# Legacy fpga directory (without pyrpl/ prefix)
fpga/out/
fpga/sdk/
fpga/ip/

# ==============================================================================
# Xilinx IP Cores - Generated Files to Ignore
# ==============================================================================
# Only essential files are tracked:
#   - *.xci          (IP configuration - required)
#   - *.dcp          (pre-synthesized checkpoint - speeds up builds)
#   - constraints/   (timing constraints - required for FIR)
#   - *_ooc.xdc      (out-of-context constraints - required for CIC)
#   - hdl/           (behavioral HDL - fallback if no .dcp)
#   - synth/         (synthesis wrapper - fallback if no .dcp)
#
# Everything else is regenerated from .xci and can be ignored.
# ==============================================================================

# IP metadata and journals
pyrpl/fpga/ip/*/*.xml
pyrpl/fpga/ip/*/*.bmj

# Memory initialization files
pyrpl/fpga/ip/*/*.mif

# Instantiation templates (reference only, not used in build)
pyrpl/fpga/ip/*/*.veo
pyrpl/fpga/ip/*/*.vho

# Stub files (for black-box simulation, not used in build)
pyrpl/fpga/ip/*/*_stub.v
pyrpl/fpga/ip/*/*_stub.vhdl
pyrpl/fpga/ip/*/*_bmstub.v

# Simulation netlists (for simulation only, not used in synthesis)
pyrpl/fpga/ip/*/*_sim_netlist.v
pyrpl/fpga/ip/*/*_sim_netlist.vhdl

# Out-of-context constraints for FIR (not used - FIR uses constraints/ folder)
pyrpl/fpga/ip/fir_*/*_ooc.xdc

# Directories with generated content not needed for build
pyrpl/fpga/ip/*/cmodel/
pyrpl/fpga/ip/*/demo_tb/
pyrpl/fpga/ip/*/doc/
pyrpl/fpga/ip/*/sim/

# Vivado temporary files in IP directory
pyrpl/fpga/ip/vivado*.jou
pyrpl/fpga/ip/vivado*.log
pyrpl/fpga/ip/vivado*.backup.jou
pyrpl/fpga/ip/vivado*.backup.log

# Plots generated by the IP analysis scripts (plot_cic_fir_cascade.py etc.)
pyrpl/fpga/ip/*.png

# Behavioural simulation artefacts
pyrpl/fpga/sim/*.wdb
pyrpl/fpga/sim/xsim.dir/

# ==============================================================================
# Backups of hand-patched sources
# ==============================================================================

*.orig_backup

# ==============================================================================
# Local data, vendor documentation and agent scratch space
# ==============================================================================

# Measurement datasets exported for analysis / sharing (can be hundreds of MB)
exports/

# Third-party hardware manuals and datasheets (large, not ours to redistribute)
docs/manuals/

# Recorded streams and plots produced by the streaming_dev bench scripts
streaming_dev/*.npy
streaming_dev/*.png

# Codex CLI scratch space (cf. .claude/)
.codex/
